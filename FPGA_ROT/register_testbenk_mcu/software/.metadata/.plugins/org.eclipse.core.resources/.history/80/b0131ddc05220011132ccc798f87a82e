#include <io.h>
#include <stdio.h>
#include <system.h>

#define REG_TEST_COMP_BASE 0x50008
#define ADR_0 0 * 2
#define ADR_1 1 * 2

#define byte unsigned char

void wr_dat_to_adr(byte dat, byte adr);
unsigned short rd_from_adr(byte adr);

void show_sar_adc();
void show_all();

volatile unsigned short *adr0_ptr =
    (volatile unsigned short *)REG_TEST_COMP_BASE;
volatile unsigned short *adr1_ptr =
    (volatile unsigned short *)REG_TEST_COMP_BASE + 2;

int main() {
  unsigned short mcu_settings;
  unsigned short mask;
  unsigned short last_seen = 0x0008;

  while (1) {
    mcu_settings = *adr1_ptr;

    printf("fuck\n");

    if ((mcu_settings & 0x0008) == 0x0008) {
    if ((mcu_settings & 0x0004) == 0x0004 && (last_seen != 0x0004)) {
    show_sar_adc();
    last_seen = 0x0004;
    } else if (last_seen != 0x0000) {
    show_all();
    last_seen = 0x0000;
    }
    }
  }
  return 0;
}
void show_all() {
  byte j;
  unsigned short temp;
  unsigned short adr;
  for (byte i = 0x0; i < 0xff; i++) {
    for (j = 0x0; j < 0xff; i++) {
      adr = i << 8;
      adr |= j;
      temp = rd_from_adr(adr);
      printf("%x,%x,%x;", i, j, temp);
    }
    printf("\n");
  }
}

void show_sar_adc() {
  byte j;
  unsigned short temp;
  for (byte i = 0x0; i < 4; i++) {
    for (j = 0x0; j < 3; i++) {
      temp = rd_from_adr(j + 0x3 * i);
      printf("%x;", temp);
    }
    printf("\n");
  }
}

void wr_dat_to_adr(byte dat, byte adr) {
  *adr0_ptr = adr;
  *adr1_ptr = dat;
}

unsigned short rd_from_adr(byte adr) {
  *adr0_ptr = adr;
  unsigned short temp = *adr0_ptr;
  return temp;
}
