#include <stdio.h>
#include <io.h>
#include <system.h>

#define SAR_ADC_ADR 0x10008
#define ADR_0 0*2
#define ADR_1 1*2

int main()
{
	unsigned int temp;

	while (1)
	{
		unsigned short temp;
		for (unsigned short i = 0; i < 10; i++){
			IOWD_16DIRECT(SAR_ADC_ADR, ADR_0, i);
			IOWD_16DIRECT(SAR_ADC_ADR, ADR_1, i);
			temp = IORD_16DIRECT(SAR_ADC_ADR, ADR_0);
			printf(temp);
		}
	}
	return 0;
}
